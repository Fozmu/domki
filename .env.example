# Copy to .env and fill in real values. .env is gitignored — never commit it.
# In Netlify: Site configuration > Environment variables > Import from .env file

# Google Cloud API key, restricted to "Places API (New)" only
GOOGLE_PLACES_API_KEY=paste-your-key-here

# Google Place ID for Domki Cesarz
GOOGLE_PLACE_ID=ChIJiaHYvqPlF0cRBo6GG-1_-qw

# Bookings storage: Netlify Blobs. No API key needed — auto-configured by
# Netlify at deploy time and by `netlify dev` locally.

# Admin panel login (/admin/panel). Generate ADMIN_PASSWORD_HASH — never
# store the plaintext password. Run locally:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('YOUR_PASSWORD',s,64).toString('hex'))"
# Generate ADMIN_SESSION_SECRET with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=paste-salt:hash-from-command-above
ADMIN_SESSION_SECRET=paste-random-hex-from-command-above
